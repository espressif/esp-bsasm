{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    }
  ],
  "surroundingPairs": [
    {
      "open": "[",
      "close": "]"
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region",
      "end": "^\\s*#\\s*endregion"
    }
  }
}
